{
  "openapi": "3.1.0",
  "info": { "title": "AWMC Assets API", "version": "1.0.0", "description": "公开静态资源接口，无需 API Key。" },
  "servers": [{ "url": "https://assets.awmc.cc" }],
  "paths": {
    "/covers/{id}": {
      "get": {
        "summary": "获取曲绘", "description": "ID 需要包含 .png 后缀。",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "0.png" } }],
        "responses": { "200": { "description": "PNG image", "content": { "image/png": { "schema": { "type": "string", "contentEncoding": "binary" } } } }, "404": { "description": "Asset not found" } }
      }
    }
  }
}
