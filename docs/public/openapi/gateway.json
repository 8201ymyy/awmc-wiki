      }
    },
    "/me/usage/failure-rate": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "查询本人失败率",
        "description": "固定近 7 天、30 分钟粒度。",
        "security": [
          {
            "AWMCGatewayToken": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/FailureRate"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AWMCGatewayToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "仅用于 api.wmc.pub：AWMC 通行证 JWT，或个人中心生成的 gw_ 长期令牌。请勿填写谱面平台或 AWMCNET 的 Key。"
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "requestBodies": {
      "Qrcode": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/QrcodeRequest"
            }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "业务响应（含 returnCode 与兼容 code）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayResponse"
            }
          }
        }
      },
      "JsonResponse": {
        "description": "JSON response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "Unauthorized": {
        "description": "令牌缺失或无效"
      },
      "InsufficientBalance": {
        "description": "余额不足或无权访问"
      },
      "FailureRate": {
        "description": "失败率统计",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/FailureRateResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "QrcodeRequest": {
        "type": "object",
        "required": [
          "qrcode"
        ],
        "properties": {
          "qrcode": {
            "type": "string",
            "description": "SGWCMAID... 二维码内容或官方链接"
          }
        }
      },
      "ChargeRequest": {
        "type": "object",
        "required": [
          "qrcode"
        ],
        "properties": {
          "qrcode": {
            "type": "string"
          },
          "chargeId": {
            "type": "integer",
            "description": "Charge ID（仅允许 chargeId=2 或 chargeId=3；也可用字段名 charge）",
            "enum": [
              2,
              3
            ],
            "example": 2
          },
          "charge": {
            "type": "integer",
            "description": "chargeId 的别名（仅允许 chargeId=2 或 chargeId=3；兼容旧客户端）",
            "enum": [
              2,
              3
            ],
            "example": 2
          }
        }
      },
      "MusicScoreItem": {
        "type": "object",
        "required": [
          "musicId",
          "level",
          "achievement",
          "dxScore"
        ],
        "properties": {
          "musicId": {
            "type": "integer",
            "description": "曲目 ID。必须是当前游戏数据里真实存在的 Music ID。"
          },
          "level": {
            "type": "integer",
            "description": "0=BASIC, 1=ADVANCED, 2=EXPERT, 3=MASTER, 4=Re:MASTER, 10=宴会场",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              10
            ]
          },
          "achievement": {
            "description": "达成率。推荐写百分比如 100.5；也可写内部整数。",
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "example": 100.5
          },
          "dxScore": {
            "type": "integer",
            "description": "fuzzy=false：实际 DX 分数；fuzzy=true：DX 星级 0～5（不是实际分数！）"
          },
          "comboStatus": {
            "description": "none/fc/fcp/ap/app 或 0～4",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "example": "ap"
          },
          "syncStatus": {
            "description": "none/fs/fsp/fsd(fdx)/fsdp(fdxp)/sync 或 0～5",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "example": "fsd"
          },
          "fuzzy": {
            "type": "boolean",
            "description": "false=精确（dxScore 为实际分）；true=模糊（dxScore 为星级）",
            "default": false
          }
        },
        "example": {
          "musicId": 11479,
          "level": 3,
          "achievement": 100.5,
          "dxScore": 2100,
          "comboStatus": "ap",
          "syncStatus": "fsd",
          "fuzzy": false
        }
      },
      "MusicUpsertRequest": {
        "type": "object",
        "required": [
          "qrcode",
          "musicList"
        ],
        "properties": {
          "qrcode": {
            "type": "string"
          },
          "musicList": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "description": "1～4 条成绩；每条由 (musicId, level) 唯一确定",
            "items": {
              "$ref": "#/components/schemas/MusicScoreItem"
            }
          }
        },
        "example": {
          "qrcode": "SGWCMAID...",
          "musicList": [
            {
              "musicId": 11479,
              "level": 3,
              "achievement": 100.5,
              "dxScore": 2100,
              "comboStatus": "ap",
              "syncStatus": "fsd",
              "fuzzy": false
            }
          ]
        }
      },
      "MusicDeleteItem": {
        "type": "object",
        "required": [
          "musicId",
          "level"
        ],
        "properties": {
          "musicId": {
            "type": "integer"
          },
          "level": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              10
            ]
          }
        },
        "additionalProperties": false
      },
      "MusicDeleteRequest": {
        "type": "object",
        "required": [
          "qrcode",
          "musicList"
        ],
        "properties": {
          "qrcode": {
            "type": "string"
          },
          "musicList": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/MusicDeleteItem"
            }
          }
        }
      },
      "ItemUpsertRequest": {
        "type": "object",
        "required": [
          "qrcode",
          "itemKind",
          "itemId",
          "operation"
        ],
        "properties": {
          "qrcode": {
            "type": "string"
          },
          "itemKind": {
            "type": "integer",
            "description": "道具种类。高风险未验证种类：4、8、15。常见：1姓名框 2称号 3头像 5-8乐曲解锁 9角色 10搭档 11框 12票 15钥匙"
          },
          "itemId": {
            "type": "integer"
          },
          "operation": {
            "type": "string",
            "enum": [
              "add",
              "del"
            ],
            "description": "add 添加 / del 删除（不区分大小写）"
          }
        }
      },
      "UserUpsertAllRequest": {
        "type": "object",
        "required": [
          "qrcode"
        ],
        "properties": {
          "qrcode": {
            "type": "string"
          },
          "musicList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MusicScoreItem"
            }
          },
          "musicDeleteList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MusicDeleteItem"
            }
          },
          "itemList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemUpsertRequest"
            }
          },
          "clearTicket": {
            "type": "boolean"
          }
        }
      },
      "KaleidxUpsertRequest": {
        "type": "object",
        "required": [
          "qrcode",
          "gateId"
        ],
        "properties": {
          "qrcode": {
            "type": "string"
          },
          "gateId": {
            "type": "integer",
            "description": "门 ID（>0）",
            "example": 7
          },
          "isGateFound": {
            "type": "boolean"
          },
          "isKeyFound": {
            "type": "boolean"
          },
          "isClear": {
            "type": "boolean"
          }
        }
      },
      "UpdateLxRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QrcodeRequest"
          },
          {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "description": "LXNS X-User-Token"
              },
              "type": {
                "type": "string",
                "description": "旧字段，可忽略",
                "example": "maimai"
              }
            }
          }
        ]
      },
      "UpdateFishRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QrcodeRequest"
          },
          {
            "type": "object",
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "description": "DivingFish Import-Token"
              }
            }
          }
        ]
      },
      "GatewayResponse": {
        "type": "object",
        "properties": {
          "returnCode": {
            "type": "integer",
            "description": "上游业务码。ping 成功=0；其它成功=1"
          },
          "returnMessage": {
            "description": "字符串；业务成功时常为 JSON 字符串"
          },
          "businessData": {
            "description": "网关解析 returnMessage 后的对象（如有）"
          },
          "code": {
            "type": "integer",
            "description": "兼容字段：业务成功时为 0",
            "example": 0
          },
          "msg": {
            "description": "兼容字段：尽量可二次 JSON.parse"
          }
        },
        "additionalProperties": true
      },
      "QueueResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "returnCode": {
            "type": "integer",
            "example": 1
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "workers": {
            "type": "integer",
            "example": 0
          },
          "msg": {
            "type": "string"
          }
        }
      },
      "FailureRateResponse": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "global",
              "user"
            ]
          },
          "days": {
            "type": "integer",
            "example": 7
          },
          "bucketMinutes": {
            "type": "integer",
            "example": 30
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "summary": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
