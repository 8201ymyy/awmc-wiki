            "$ref": "#/components/responses/Success"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/InsufficientBalance"
          }
        }
      }
    },
    "/v1/kaleidx-scope/upsert": {
      "post": {
        "tags": [
          "Kaleidx"
        ],
        "summary": "改门（高风险）",
        "description": "消耗 5 Token。映射 `/upsert-kaleidx-scope`。\n\n**高风险：改门极可能对账号造成不可逆严重后果，请勿随意调用。**\n\n`gateId` 必填；`isGateFound` / `isKeyFound` / `isClear` 至少提供一项。",
        "security": [
          {
            "AWMCGatewayToken": []
